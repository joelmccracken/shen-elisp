" (shen.app (nth (+ 1 V5763) (reverse V5765)) "" shen.a)) (stoutput)) (if (or (= V5764 "") (symbol? V5763)) (shen.recursive-string-match 0 V5764 (reverse V5765)) (simple-error "% expects a number or a symbol
